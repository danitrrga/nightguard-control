[Unit]
Description=Nightguard watchdog (root) — revert tampered config + restore browser policies
# System (root) unit: no %h. Absolute ExecStart + Environment=NIGHTGUARD_DIR (Phase 7 D-2).
# Runs as root so it can read the root-owned .guardkey (Phase 7 ROOT-01).
#
# ExecStart points at the DEPLOYED, root-owned copy, never at the working tree. It used to
# run the watchdog straight out of a working tree in someone.s home —
# a user-writable file in a user-writable directory, executed as root every 60 seconds, so
# rewriting it was arbitrary root code with no password. Deploy with scripts/linux/deploy.sh.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=NIGHTGUARD_DIR=/var/lib/nightguard
ExecStart=/usr/bin/python3 /usr/local/lib/nightguard/nightguard_watchdog.py
