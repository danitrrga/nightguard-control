# /etc/sudoers.d/nightguard — Phase 7 ROOT-03/04, hardened 2026-09-05
#
# Allow the nightguard owner to invoke the control-CLI as root to sign sanctioned
# config changes. Password REQUIRED (no NOPASSWD): the password prompt IS the
# deliberate anti-impulse friction (ROOT-04). Scoped to the control-CLI's
# commit/verify subcommands only; the CLI validates its own args (argparse) and
# only ever writes inside NIGHTGUARD_DIR, then chowns config.yaml back to the user.
#
# The path MUST be the deployed, root-owned copy under /usr/local/lib/nightguard. It
# previously named the working tree in the user's home, where the user could rewrite
# nightguard_ctl.py and then have sudo run it — one password bought arbitrary root code and,
# more to the point, a signer with the weekly-token check removed. Root-owned code closes it.
#
# Install (validate BEFORE it lands in /etc) — scripts/linux/deploy.sh does this for you:
#   sudo visudo -cf .../nightguard.sudoers \
#     && sudo install -m 0440 -o root -g root .../nightguard.sudoers /etc/sudoers.d/nightguard
#
# Footgun note (07-CONTEXT): scope to fixed subcommands, never a bare trailing '*'
# on the whole command line.

Cmnd_Alias NIGHTGUARD_CTL = \
    /usr/bin/python3 /usr/local/lib/nightguard/nightguard_ctl.py commit *, \
    /usr/bin/python3 /usr/local/lib/nightguard/nightguard_ctl.py verify

danitrrga ALL=(root) NIGHTGUARD_CTL
