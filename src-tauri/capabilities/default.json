{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability: core + fs watch narrowed to the resolved nightguard data dir.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.nightguard" },
        { "path": "$HOME/.nightguard/**" },
        { "path": "$APPDATA/nightguard" },
        { "path": "$APPDATA/nightguard/**" }
      ]
    }
  ]
}
